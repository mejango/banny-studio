<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.banny.live</string>
    <key>ProgramArguments</key>
    <array/>
    <key>EnvironmentVariables</key>
    <dict/>
    <key>UserName</key>
    <string>_bannylive</string>
    <key>GroupName</key>
    <string>_bannylive</string>
    <key>WorkingDirectory</key>
    <string>/var/empty</string>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>Umask</key>
    <string>077</string>
    <key>StandardOutPath</key>
    <string>/Library/Logs/Banny Live/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/Banny Live/stderr.log</string>
</dict>
</plist>
